{
  "name": "@morphfx/core",
  "version": "0.1.0-next.0",
  "description": "Framework-agnostic SVG path morphing engine.",
  "keywords": [
    "svg",
    "morph",
    "morphing",
    "path",
    "animation",
    "interpolation",
    "shape"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cesarvenzac/morph.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/cesarvenzac/morph#readme",
  "bugs": "https://github.com/cesarvenzac/morph/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./animate": {
      "import": {
        "types": "./dist/animate.d.ts",
        "default": "./dist/animate.js"
      },
      "require": {
        "types": "./dist/animate.d.cts",
        "default": "./dist/animate.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "size": "size-limit",
    "bench": "vitest bench --run --reporter=verbose"
  },
  "size-limit": [
    {
      "name": "@morphfx/core (everything)",
      "path": "dist/index.js",
      "limit": "6 kB"
    },
    {
      "name": "@morphfx/core/animate",
      "path": "dist/animate.js",
      "limit": "1.5 kB"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "fast-check": "catalog:",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
