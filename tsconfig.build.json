{
  // The published build: ESM and type declarations in dist/, from the sources the site uses as
  // they are. Tests, their icons and the site's internals stay out.
  "compilerOptions": {
    "target": "ES2022",
    // The DOM's types for the dom and react entries; the main one uses none of it, and runs anywhere.
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "noUncheckedSideEffectImports": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.fixture.ts", "src/internal.ts"]
}
