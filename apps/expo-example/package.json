{
  "name": "@morphfx/expo-example",
  "version": "0.0.0",
  "private": true,
  "description": "Expo example for @morphfx/react-native (iOS, Android and web).",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "catalog:expo",
    "@morphfx/react-native": "workspace:*",
    "expo": "catalog:expo",
    "expo-status-bar": "catalog:expo",
    "react": "catalog:expo",
    "react-dom": "catalog:expo",
    "react-native": "catalog:expo",
    "react-native-reanimated": "catalog:expo",
    "react-native-svg": "catalog:expo",
    "react-native-web": "catalog:expo",
    "react-native-worklets": "catalog:expo"
  },
  "devDependencies": {
    "@react-native/metro-config": "catalog:expo",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
